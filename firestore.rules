
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'check22@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData(request.auth.uid).get('role', 'member') in ['admin', 'super_admin'])
      );
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'check22@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData(request.auth.uid).get('role', 'member') == 'super_admin')
      );
    }

    // =========================
    // 🔐 Users Collection
    // =========================
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // =========================
    // 📅 Club Events Collection
    // =========================
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // =========================
    // 🧠 LEO AI Knowledge
    // =========================
    match /leo_ai_knowledge/{id} {
      // Simplified: Public info is readable by all. Protected info checked by role.
      allow read: if 
        resource.data.get('visibility', 'public') == 'public' ||
        (isSignedIn() && resource.data.get('visibility', 'members') == 'members') ||
        isAdmin();
      allow write: if isSuperAdmin();
    }

    match /leo_ai_conversations/{id} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // =========================
    // ✅ Attendance Collection
    // =========================
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);
      allow create: if 
        isAdmin() ||
        (!isSignedIn() && request.resource.data.get('attendanceType', '') == 'visitor') ||
        (isSignedIn() && request.resource.data.get('attendanceType', '') == 'member' && request.resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================
    // 🎟️ District Access Platform (Isolated Collections)
    // =========================
    match /accessEvents/{eventId} {
      allow read, get: if true; 
      allow write: if isAdmin() || (isSignedIn() && getUserData(request.auth.uid).get('permissions', {}).get('district_access', false) == true);
    }
    
    match /accessRegistrations/{regId} {
      allow create: if true;
      allow read, get, list: if isAdmin() || (isSignedIn() && getUserData(request.auth.uid).get('permissions', {}).get('district_access', false) == true);
      allow update, delete: if isAdmin() || (isSignedIn() && getUserData(request.auth.uid).get('permissions', {}).get('district_access', false) == true);
    }

    // =========================
    // ✨ AI Welcome Check-ins
    // =========================
    match /checkins/{checkinId} {
      allow read: if true; 
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // =========================
    // 💬 Communication Groups
    // =========================
    match /communicationGroups/{groupId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // 💡 Project Ideas
    // =========================
    match /projectIdeas/{ideaId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /transactions/{transactionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // =========================
    // 🏆 Points Entries
    // =========================
    match /pointsEntries/{entryId} {
      allow read, write: if isAdmin();
    }
    
    match /dailyTasks/{taskId} {
      allow read, write: if isAdmin();
    }
    
    match /tasks/{taskId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.get('assigneeIds', []) || isAdmin());
      allow delete: if isAdmin();
    }

    match /tasks/{taskId}/comments/{commentId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
    }
    
     match /tasks/{taskId}/activity/{activityId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn() || isAdmin();
        allow update, delete: if isAdmin();
    }

    // =========================
    // 📊 Monthly Reporting
    // =========================
    match /monthlyReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && (getUserData(request.auth.uid).get('permissions', {}).get('project_ideas', false) == true));
    }

    // =========================
    // 📝 Submissions & Review
    // =========================
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && (getUserData(request.auth.uid).get('permissions', {}).get('project_ideas', false) == true));
    }
  }
}
