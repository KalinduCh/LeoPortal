
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "admin", "super_admin"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "source": { "type": "string", "enum": ["portal", "entrivo"] },
        "permissions": { "type": "object" },
        "membershipFeeStatus": { "type": "string", "enum": ["paid", "pending", "partial"] },
        "membershipFeeAmountPaid": { "type": "number" },
        "fcmToken": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "status"]
    },
    "AiKnowledge": {
      "title": "AI Knowledge Entry",
      "description": "Factual entries used by LEO AI for RAG context",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public", "members", "admin_only"] },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "category", "visibility", "isActive"]
    },
    "MonthlyReport": {
      "title": "Monthly Report",
      "description": "Repository links for periodic club reports",
      "type": "object",
      "properties": {
        "month": { "type": "number", "description": "0-11 index" },
        "year": { "type": "number" },
        "viewUrl": { "type": "string", "format": "uri" },
        "uploadUrl": { "type": "string", "format": "uri" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["month", "year"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Collection of user profiles"
    },
    "/leo_ai_knowledge/{id}": {
      "schema": "#/backend/entities/AiKnowledge",
      "description": "The LEO AI Brain knowledge base"
    },
    "/monthlyReports/{reportId}": {
      "schema": "#/backend/entities/MonthlyReport",
      "description": "Archive of monthly report folder links"
    },
    "/leo_ai_conversations/{id}": {
      "schema": "object",
      "description": "Transient AI chat history"
    }
  }
}
